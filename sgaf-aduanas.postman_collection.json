			"name": "Authentication (ms-auth)",
			"item": [
				{
					"name": "Login as Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = typeof pm !== 'undefined' ? pm.response.json() : res.getBody();",
									"var setVar = function(key, value) {",
									"    if (typeof pm !== 'undefined') {",
									"        pm.collectionVariables.set(key, value);",
									"    } else if (typeof bru !== 'undefined') {",
									"        bru.setVar(key, value);",
									"    }",
									"};",
									"if (jsonData && jsonData.data && jsonData.data.access_token) {",
									"    setVar(\"token\", jsonData.data.access_token);",
									"}",
									"if (jsonData && jsonData.data && jsonData.data.user) {",
									"    setVar(\"userId\", jsonData.data.user.id);",
									"    setVar(\"userRol\", jsonData.data.user.rol);",
									"    setVar(\"userAduana\", jsonData.data.user.aduana || \"\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"run\": \"admin001\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
